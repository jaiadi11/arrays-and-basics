class Solution(object):
    def majorityElement(self, nums):
        """
        :type nums: List[int]
        :rtype: int
        """
        cou=0
        can=None
        for i in nums:
            if cou ==0:
                can=i
            if i ==can:
                cou+=1
            else:
                cou-=1
        return(can)

      
